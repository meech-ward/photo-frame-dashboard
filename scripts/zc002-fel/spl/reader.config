# Target-specific SPL settings for the tested ZC002 Allwinner A33 board.
CONFIG_DRAM_CLK=456
CONFIG_DRAM_ZQ=15291
CONFIG_SUNXI_NO_PMIC=y
CONFIG_SYS_CLK_FREQ=408000000
CONFIG_MMC_SUNXI_SLOT_EXTRA=2
CONFIG_ENV_IS_NOWHERE=y
CONFIG_SYS_MALLOC_F_LEN=0x1000
CONFIG_SPL_SYS_MALLOC_F_LEN=0x1000

# Storage reads only, including when the base defconfig enables writes.
# CONFIG_SPL_MMC_WRITE is not set

# Keep unrelated subsystems out of this small SPL build.
# CONFIG_AXP_GPIO is not set
# CONFIG_VIDEO_SUNXI is not set
# CONFIG_USB_MUSB_HOST is not set
# CONFIG_USB_MUSB_GADGET is not set
# CONFIG_USB_GADGET is not set
# CONFIG_USB_EHCI_HCD is not set
# CONFIG_USB_OHCI_HCD is not set
# CONFIG_MMC_TRACE is not set
# CONFIG_CONSOLE_RECORD is not set
# CONFIG_SPL_MMC_TINY is not set
