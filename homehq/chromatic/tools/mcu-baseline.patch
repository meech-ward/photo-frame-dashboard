+bool Button_IsDown(Button_t b)
+{
+    bool down = false;
+    if ((unsigned)b >= kNumButtons) return false;
+    if (Mutex_Take(kMutexKey_Buttons) == kMutexResult_Ok) {
+        down = (_PrevButtons & (1u << b)) != 0;
+        (void)Mutex_Give(kMutexKey_Buttons);
+    }
+    return down;
+}
