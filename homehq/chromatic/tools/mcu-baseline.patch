+void FPGA_Tx_PulseMenu(void)
+{
+    uint8_t buffer[14] = {0};
+    // The FPGA consumes bit 8, not bit 9, as its synthetic menu button. Send
+    // release directly too: Button_PokeInputs routes zero locally while visible,
+    // which would leave the FPGA button held and prevent its release-edge toggle.
+    uint16_t buttons = kButtonBits_MenuEnAlt;
+    size_t size = SetupTxBuffer(buffer, kTxCmd_PokeButton, sizeof(buttons), &buttons);
+    uart_write_bytes(UART_NUM_1, buffer, size);
+    uart_wait_tx_done(UART_NUM_1, pdMS_TO_TICKS(100));
+    vTaskDelay(pdMS_TO_TICKS(60));
+    buttons = 0;
+    size = SetupTxBuffer(buffer, kTxCmd_PokeButton, sizeof(buttons), &buttons);
+    uart_write_bytes(UART_NUM_1, buffer, size);
+    uart_wait_tx_done(UART_NUM_1, pdMS_TO_TICKS(100));
+}
+
 static size_t SetupTxBuffer(uint8_t *const pBuffer, TxIDs_t eID, uint8_t Len, void* pData)
 {
     if ((pBuffer == NULL) || (Len > kSysMgmtConsts_MsgProtoV2Len) || (pData == NULL) || ((unsigned)eID >= kNumTxCmds))
